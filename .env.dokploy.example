# Dokploy Production Environment Variables
# Copy this file and fill in the real values before deploying

# ===================== REQUIRED =====================

# Backend API domain (e.g., api.icsncardiology.org)
API_DOMAIN=api.YOURDOMAIN.com

# Frontend/Admin Dashboard domain (e.g., admin.icsncardiology.org)
FRONTEND_DOMAIN=admin.YOURDOMAIN.com

# Django Secret Key - generate a strong random key for production
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-this-to-a-50-char-random-string

# Database URL - can keep Neon or use a local Postgres
# Example Neon: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ===================== SMTP / EMAIL =====================

# Sender name and email shown in OTP emails
DEFAULT_FROM_EMAIL=HeartBeat Harmony <support@ICSNCardiology.org>

# SMTP Server settings (from your email provider)
# For Hostinger email or professional email hosting:
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Email credentials - the support@ICSNCardiology.org account
EMAIL_HOST_USER=support@ICSNCardiology.org
EMAIL_HOST_PASSWORD=your-email-password-here

# ===================== CLOUDFLARE R2 / S3 OBJECT STORAGE (optional) =====================
# Set USE_S3=True and fill in credentials to store media files on R2 (or any S3 endpoint)
# instead of on the VPS disk. When USE_S3=False (the default), local disk storage is used.
#
# S3_* vars are the preferred names. R2_* vars below are the backward-compat fallback —
# if you already have R2_* set in your deployment secrets you don't need to rename them.

# Toggle — set to True to activate S3 storage
USE_S3=False

# Preferred (S3_*) variable names:
S3_ACCESS_KEY=your-r2-access-key-id
S3_SECRET_KEY=your-r2-secret-access-key
S3_BUCKET=hartbeat-harmony-media
S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
# Public domain for serving files — either the pub-xxxx.r2.dev URL or a custom domain.
# Do NOT include https:// prefix here.
S3_PUBLIC_URL=pub-xxxx.r2.dev

# Legacy fallback names (still accepted if S3_* are not set):
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET_NAME=hartbeat-harmony-media
# R2_CUSTOM_DOMAIN=pub-xxxx.r2.dev
